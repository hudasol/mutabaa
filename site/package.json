{
  "name": "mutabaa-site",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build:offline": "vite build --config vite.single.config.ts",
    "test:e2e": "playwright test",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@6.0.1 --omit dev --output-file ../sbom/site.cdx.json --spec-version 1.5",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans-arabic": "5.2.8",
    "react": "19.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
